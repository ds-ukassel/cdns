{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdns.schema.json",
  "title": "CDNs",
  "description": "A list of CDNs with identifiers",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "description": "The unique name of the CDN",
        "type": "string",
        "minLength": 1
      },
      "type": {
        "description": "The type of the CDN",
        "enum": ["private", "commercial", "public_asset", "other"],
        "minLength": 1
      },
      "website": {
        "description": "The website of the CDN",
        "type": "string",
        "minLength": 1
      },
      "homepage": {
        "description": "The homepage URL of the CDN",
        "type": "string",
        "minLength": 1
      },
      "domains": {
        "description": "The domains (or domain snippets) associated with the CDN",
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      },
      "ranges": {
        "description": "The IP ranges associated with the CDN",
        "type": "array",
        "items": {
          "$ref": "#/$defs/range_source"
        },
        "minItems": 1,
        "additionalProperties": false
      },
      "asns": {
        "description": "The ASNs associated with the CDN",
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "minItems": 1
      },
      "headers": {
        "description": "The HTTP headers commonly used by the CDN",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "name"
    ]
  },
  "$defs": {
    "range_source": {
      "type": "object",
      "properties": {
        "range_type": {
          "type": "string",
          "enum": ["ipv4", "ipv6", "combined"]
        },
        "last_updated": {
          "type": "string",
          "format": "date-time"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "ranges": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      },
      "required": ["range_type"],
      "oneOf": [
        {
          "required": ["url"],
          "not": {
            "required": ["ranges"]
          }
        },
        {
          "required": ["ranges", "last_updated"],
          "not": {
            "required": ["url"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
